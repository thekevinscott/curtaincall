{
  "name": "curtaincall",
  "version": "0.0.1",
  "description": "Testing library for terminal applications",
  "license": "MIT",
  "repository": "https://github.com/thekevinscott/curtaincall",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vitest": {
      "types": "./dist/vitest.d.ts",
      "default": "./dist/vitest.js"
    },
    "./ansi": {
      "types": "./dist/ansi.d.ts",
      "default": "./dist/ansi.js"
    }
  },
  "files": ["dist/", "README.md"],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:unit": "vitest run src",
    "test:integration": "vitest run tests/integration"
  },
  "peerDependencies": {
    "vitest": ">=3"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "dependencies": {
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/headless": "^6.0.0",
    "node-pty": "^1.1.0",
    "shlex": "^3.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@tsconfig/node22": "^22.0.7",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  }
}
